# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# WHOOP API Integration
# Create an app at: https://developer.whoop.com/
# Request scopes: read:recovery, read:sleep, read:workout, read:cycles, read:profile, offline
VITE_WHOOP_CLIENT_ID=your_whoop_client_id_here
VITE_WHOOP_CLIENT_SECRET=your_whoop_client_secret_here
VITE_WHOOP_REDIRECT_URI=http://localhost:5173/whoop-callback
