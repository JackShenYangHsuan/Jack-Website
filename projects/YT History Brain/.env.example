OPENROUTER_API_KEY=your_key_here
GOOGLE_EMAIL=your_email@gmail.com

# Embedding choice: "openrouter" or "local"
EMBEDDING_PROVIDER=local

# LLM model via OpenRouter
LLM_MODEL=anthropic/claude-3.5-sonnet

# Sync schedule (cron format)
SYNC_SCHEDULE=0 3 * * *

# Path to Google Takeout watch history HTML (optional)
# Default: ~/Downloads/Takeout/YouTube and YouTube Music/history/watch-history.html
TAKEOUT_HTML_PATH=

# Frontend configuration (for frontend/.env)
# VITE_API_BASE=http://localhost:8000/api
