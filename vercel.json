{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/tennis-clips/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    },
    {
      "source": "/projects/tennis-clips/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/tennis-clips", "destination": "/projects/tennis-clips" },
    { "source": "/tennis-clips/:path*", "destination": "/projects/tennis-clips/:path*" },
    { "source": "/visionquest/:path*", "destination": "/visionquest/index.html" },
    { "source": "/talktojack/admin", "destination": "/talktojack/admin.html" },
    { "source": "/talktojack", "destination": "/talktojack/index.html" },
    { "source": "/gmail-auto-label", "destination": "/" },
    { "source": "/vision-quest", "destination": "/" },
    { "source": "/claude-code-music", "destination": "/" },
    { "source": "/command-center", "destination": "/" },
    { "source": "/building-daystory", "destination": "/" },
    { "source": "/nvidia-dgx-spark", "destination": "/" },
    { "source": "/rag-pdf-chat", "destination": "/" },
    { "source": "/reducto-mcp", "destination": "/" },
    { "source": "/prompt-director", "destination": "/" },
    { "source": "/ai-workflows", "destination": "/" }
  ]
}
